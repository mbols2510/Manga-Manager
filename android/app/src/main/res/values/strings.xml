    <string name="pairing_error_rejected_code">The server rejected this code. It may have been revoked; create a new one under Settings &gt; Devices.</string>
    <string name="pairing_error_server">The server answered with an unexpected status (HTTP %1$s). Try again later.</string>
    <string name="pairing_error_store">Pairing could not be completed and nothing was saved. Try again.</string>
