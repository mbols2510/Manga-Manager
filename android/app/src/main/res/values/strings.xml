    <!-- Pairing -->
    <string name="pairing_title">Pair with your server</string>
    <string name="pairing_explanation">On the Manga Manager web dashboard, open Settings &gt; Devices, add this device and copy its pairing code. Paste the whole code below. Treat it like a password: it contains this device\'s access token.</string>
