# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL) ---------------------------------------------------
# Your own server:  create a database first (CREATE DATABASE manga_manager;)
DATABASE_URL=postgresql://manga:change-me@postgres-host:5432/manga_manager
# Bundled database (docker compose --profile db up -d): leave DATABASE_URL empty and set
#   POSTGRES_HOST=db  POSTGRES_USER=manga  POSTGRES_PASSWORD=change-me  POSTGRES_DB=manga_manager

# --- Paths on the host -------------------------------------------------------
SUWAYOMI_DOWNLOADS=/path/to/suwayomi/downloads
MANGA_ROOT=/path/to/kavita/manga
TZ=Europe/Brussels

# --- Optional first values (everything can also be set on the Settings page) -
KAVITA_URL=http://kavita:5000
KAVITA_API_KEY=
SUWAYOMI_URL=http://suwayomi:4567
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=
NTFY_ENABLED=false
NTFY_URL=
NTFY_TOKEN=
WEB_PUBLIC_URL=

# Optional: invite code for the sign-up page, fixed secret for login sessions
SIGNUP_CODE=
WEB_SECRET_KEY=
