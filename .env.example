# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL) ---------------------------------------------------
# Your existing PostgreSQL server and database. Tables are created automatically on start.
DATABASE_URL=postgresql://user:password@postgres-host:5432/database

# --- Paths on the host -------------------------------------------------------
SUWAYOMI_DOWNLOADS=/path/to/suwayomi/downloads
MANGA_ROOT=/path/to/kavita/manga
# Double Chapters uses /manga inside the container (DC_MANGA_ROOT), not this host path.
TZ=Europe/Brussels

# --- Optional first values (everything can also be set on the Settings page) -
KAVITA_URL=http://kavita:5000
KAVITA_API_KEY=
SUWAYOMI_URL=http://suwayomi:4567
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=
NTFY_ENABLED=false
NTFY_URL=
NTFY_TOKEN=
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
WEB_PUBLIC_URL=

# Optional: invite code for the sign-up page, fixed secret for login sessions
SIGNUP_CODE=
WEB_SECRET_KEY=
